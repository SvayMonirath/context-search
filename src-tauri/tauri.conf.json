{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Context Vault",
  "version": "2.0.0",
  "identifier": "com.contextvault.desktop",
  "build": {
    "beforeDevCommand": "pnpm --prefix ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --prefix ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Context Vault",
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
